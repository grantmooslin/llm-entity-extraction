# Environment / secrets — never commit real credentials.
# Live (gitignored) dotenv files live under config/environments/.
config/environments/.env
config/environments/braintrust.env
config/environments/braintrust-sandbox.env
config/environments/langfuse.env
config/environments/*.env.local
# Root-level safety net (one release): still block the old paths in case
# anyone has not moved their live files yet.
.env
braintrust.env
langfuse.env
*.env.local

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Local run artifacts — the directories are gitignored (contents regenerated
# locally) but each keeps a committed README.md placeholder documenting what it
# holds and how to regenerate it.
data/manifests/*
!data/manifests/README.md
data/samples/*
!data/samples/README.md
data/legalbench_local/*
!data/legalbench_local/README.md
# the full CUAD v1 PDF corpus (~510 contracts) — local only
data/cuad_pdfs/*
!data/cuad_pdfs/README.md
# MAUD local dumps (152 agreements, ~168 MB) — regenerate via stream_maud_to_bt.py --local-dump
data/maud/*
!data/maud/README.md
# EDGAR S-1 corporate-record dumps — regenerate via stream_s1_exhibits.py --local-dump
data/s1_corporate_records/*
!data/s1_corporate_records/README.md
# post-hoc LLM-judge calibration records — written by judge_experiment.py
data/judgments/*
!data/judgments/README.md
# KANBAN-069: BT→HF mirror staging (exports + images) — uploaded to the Hub, never committed
/data/hf_export/*
!/data/hf_export/README.md
reports/*.png
reports/*.csv
# Experiment log — the jsonl exceeded GitHub's 100 MB hard limit (GH001,
# push rejected with an LFS suggestion); kept local-only, never tracked.
# The public record lives in docs/data (site) + CHANGELOG.md.
reports/experiment_log.jsonl
reports/experiment_log.md

# OS junk
.DS_Store

# Arize Phoenix local trace sink (SQLite + wasm runtime) — never commit
.phoenix/

# Merged docclass corpus (676 rows, ~170 MB — regenerate via build_docclass_merged.py)
data/datasets/*
!data/datasets/README.md

# ContractEval CUAD test split (arXiv 2508.03080) — the pairs + full-contract
# texts + download cache are derived corpora (regenerate via
# build_contracteval_testset.py); questions.json + testset_summary.json ARE
# committed (curated reference + reproducible metadata).
data/contracteval/_cache/
data/contracteval/contracteval_test.jsonl
data/contracteval/contracteval_contracts.jsonl

# ────────────────────────────────────────────────────────────────────────────
# Quarto / Posit Cloud — generated artifacts NOT tracked by git.
#
# The Posit Cloud portal sources live in `docs/posit-src/` and render into `docs/posit/`.
# Everything below is regenerated on every `quarto render site` (the
# `_pre-render.py` hook recreates the includes + variables first), so tracking
# it would only add churn — the rendered PAGES (`docs/posit/*.html`), the
# search index and `docs/posit/site_libs/` ARE committed on purpose: GitHub
# Pages serves /docs directly with no build step (no Actions), so the served
# pages must carry their own assets.
# ────────────────────────────────────────────────────────────────────────────

# Quarto project state (rendering cache / metadata) — any project level
.quarto/
**/.quarto/
# Quarto alternate-site / freeze conventions (defensive; not used here)
_site/
_freeze/
/checkpoint/

# Quarto library bundles + render intermediates. `quarto render` vendors its
# JS/CSS libraries into `site_libs/` (bootstrap, clipboard, quarto-html,
# quarto-nav, quarto-search, ...) and drops per-page intermediates into
# `*_files/` (e.g. `experiment-log_files/`) next to the source project — both
# regenerated on every render, so tracking them would only add churn. The
# COMMITTED copies under `docs/posit/site_libs/` stay tracked on purpose (GH
# Pages serves /docs with no build step — see the header comment above); these
# rules cover only the untracked source-tree copies Quarto leaves behind.
docs/posit-src/site_libs/
docs/posit-src/*_files/
docs/posit-src/**/*_files/
docs/posit-src/*.html
docs/posit-src/search.json

# Pre-render build intermediates for the Posit portal — regenerated from
# reports/experiment_log.jsonl, MESSAGE_BOARD.md and MESSAGE_BOARD_DISCUSSION.qmd
# by site/_pre-render.py before EVERY render (they carry generation stamps, so
# tracking them would dirty `git status` after every rebuild).
docs/posit-src/_includes/
docs/posit-src/_variables.yml

# Vendored editable checkout of the llm-dojo-scoring dependency (KANBAN-044) —
# a local dev clone used for the API audit and `pip install -e .`; the
# authoritative source is the pinned git dependency in pyproject.toml /
# requirements.txt (`llm-dojo-scoring @ git+…@v0.2.0`).
src/llm-dojo-scoring/

# Monte Carlo joint corpus (KANBAN-048) — derived from the experiment log +
# manifests, embeds reasoning traces, rebuildable with
# scripts/reporting/monte_carlo_corpus.py; the scenario md/PNG outputs ARE
# tracked under reports/monte_carlo/.
reports/monte_carlo/corpus.jsonl

# Standalone renders of the board sources (quarto render MESSAGE_BOARD_DISCUSSION.qmd
# / MESSAGE_BOARD.qmd) — tracked only in the pre-ignore era; KANBAN-053 untracked them
MESSAGE_BOARD.html
MESSAGE_BOARD_DISCUSSION.html
MESSAGE_BOARD_DISCUSSION.md

# Posit Cloud / Posit Connect / RStudio local-only artifacts
rsconnect/
.Rproj.user/
.Rhistory
.RData
.Ruserdata
.Rcheck/
renv/library/
renv/local/
renv/staging/

/.quarto/
**/*.quarto_ipynb

# Graphify build artifacts (graphs live in the sibling -graph Pages repos)
graphify-out/

# setuptools/quarto transient build output (never commit)
/build/
