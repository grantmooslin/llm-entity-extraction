# Braintrust sandbox project — prompt + dataset sync target for iterative
# improvement and eval testing. Copy to braintrust-sandbox.env and fill in the
# API key. braintrust-sandbox.env is gitignored (same as braintrust.env).

# Braintrust organization (shared with mailroom-eval).
BRAINTRUST_ORG_ID=b0eea81a-56db-4be2-91a9-bbe17ab6d648

# Sandbox project — Mailroom-Sandbox on Braintrust.
BRAINTRUST_PROJECT_NAME=mailroom-sandbox
BRAINTRUST_PROJECT_ID=ba222477-2e1c-4fef-9f5d-02cc78765fe3

# Dataset project (same as experiments for the sandbox).
BRAINTRUST_DATASET_PROJECT=mailroom-sandbox

# Default model for sandbox evals (overridable per run).
BRAINTRUST_MODEL=qwen/qwen3.7-flash

BRAINTRUST_API_BASE=https://api.braintrust.dev

# Project-scoped Braintrust API key (mailroom-sandbox).
BRAINTRUST_API_KEY=your-braintrust-sandbox-api-key-here
