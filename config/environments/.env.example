# llm-entity-extraction — environment template
# Copy to config/environments/.env and fill in real values (.env is gitignored).
# Full guide with per-provider/per-sink recipes: docs/configuration.md

# ── Required ────────────────────────────────────────────────────────────────
# OpenRouter API key (primary provider for every eval runner).
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Externally-funded key: reachable ONLY via --research-funding-key on eval
# runners; the production gate refuses dry-runs and sub-full-dataset samples,
# so external funding pays solely for fully-ready production runs.
# RESEARCH_FUNDING_OPENROUTER_API_KEY=sk-or-...

# ── Provider seam: flip this pipeline onto a self-hosted endpoint ──────────
# Every client resolves OPENROUTER_BASE_URL AT CALL TIME, so dotenv values
# work (fixed in KANBAN-096). Point it at any OpenAI-compatible server:
#
# Modal-deployed vLLM (deploy/README.md has deploy/flip/smoke/teardown):
#   pip install -e ".[deploy]" && cd deploy && modal deploy modal_vllm.py
#   OPENROUTER_BASE_URL=https://<workspace>--entity-vllm-serve.modal.run/v1
#   (the KEY NAME stays OPENROUTER_API_KEY; its VALUE = your MODAL_VLLM_API_TOKEN)
#
# Deploy-time knobs are set BEFORE `modal deploy`, not here:
#   MODAL_VLLM_MODEL / MODAL_VLLM_GPU / MODAL_VLLM_QUANTIZATION /
#   MODAL_VLLM_MAX_MODEL_LEN / MODAL_VLLM_API_TOKEN / HF_TOKEN
#
# Cross-repo contract: llm-mailroom speaks the SAME server through its own
# seam (DEFAULT_PROVIDER=vllm + VLLM_BASE_URL + VLLM_API_KEY), so ONE Modal
# deployment can back BOTH pipelines.
# VLLM_BASE_URL=https://<workspace>--entity-vllm-serve.modal.run/v1
# VLLM_API_KEY=<your MODAL_VLLM_API_TOKEN value>

# ── Trace sinks (run_langfuse_*_eval.py) ───────────────────────────────────
# Arize Phoenix local trace sink is the default fallback: single-process,
# SQLite-backed, OpenTelemetry-native; no cloud subscription, no quota.
# Order: Langfuse when its keys are set -> else local Phoenix (default-on);
# the experiment log records tracing_backend either way.
# See wiki/Phoenix-Tracing.md for resume/checkpoint/queue/cache details.
PHOENIX_TRACING=enabled
PHOENIX_ENDPOINT=http://localhost:6006/v1/traces
# PHOENIX_SERVICE_NAME=llm-entity-extraction
# PHOENIX_PROJECT=llm-dojo

# Langfuse (primary when configured): https://us.cloud.langfuse.com or self-hosted
# LANGFUSE_PUBLIC_KEY=pk-lf-xxxx
# LANGFUSE_SECRET_KEY=sk-lf-xxxx
# LANGFUSE_HOST=http://localhost:3000

# LangChain OpenTelemetry instrumentation -> Phoenix spans for every LLM call.
LANGCHAIN_TRACING_V2=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006/v1/traces

# LangSmith (parallel per-call tracing; project NAME not id — a UUID here
# silently CREATES a junk project instead of routing).
# LANGSMITH_API_KEY=lsv2_pt_...
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=HEARSAY
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Hugging Face Hub token (Enron correspondence-dedup, gated datasets).
# HF_TOKEN=hf_...

# Braintrust stays READ-ONLY here (dataset hosting); scored-run/span logging
# is quota-metered and disabled by default. Flip to enabled to opt back in.
# The correspondence runner (`run_correspondence_eval.py`) defaults traces ON
# via --braintrust-logging regardless of this env var; pass
# --no-braintrust-logging to keep the house default.
BRAINTRUST_LOGGING=disabled
# BRAINTRUST_API_KEY=
# BRAINTRUST_PROJECT=mailroom-eval
